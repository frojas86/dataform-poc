config { type: "table" }

SELECT
    u.id AS user_id,
    u.display_name,
    u.reputation,
    (SELECT COUNT(*) FROM ${ref("posts_questions_source")} q WHERE q.owner_user_id = u.id) AS question_count,
    (SELECT COUNT(*) FROM ${ref("posts_answers_source")} a WHERE a.owner_user_id = u.id) AS answer_count
FROM
    ${ref("users_source")} u
