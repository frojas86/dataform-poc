UNION ALL
SELECT 14, "n", false, 3.4, DATE("2023-03-04"), TIMESTAMP("2023-03-04 12:00:00"), "qux", 1400, "m", "source3"
UNION ALL
SELECT 15, "o", true, 3.5, DATE("2023-03-05"), TIMESTAMP("2023-03-05 12:00:00"), "quux", 1500, "l", "source3"
