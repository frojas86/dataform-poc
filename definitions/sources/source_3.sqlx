
config { type: "table" }

SELECT 11 as col1, "k" as col2, true as col3, 3.1 as col4, DATE("2023-03-01") as col5, TIMESTAMP("2023-03-01 12:00:00") as col6, "foo" as col7, 1100 as col8, "p" as col9, "source3" as col10
UNION ALL
