config {
    type: "table",
    description: "Trip type dimension table"
}

SELECT
    FARM_FINGERPRINT(trip_type) as trip_type_key,
    trip_type,
    CASE
        WHEN trip_type = '1'
        THEN 'Street-hail'
        WHEN trip_type = '2'
        THEN 'Dispatch'
        ELSE 'Unknown'
    END AS trip_type_name
FROM
    ${ref("tlc_green_trips_2022")}